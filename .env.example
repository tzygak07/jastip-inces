# Airtable Mock untuk development — server only, jangan pernah aktif di Vercel
# Saat aktif (true), client.ts membaca data dari src/lib/airtable/fixtures/*.json tanpa memanggil Airtable sama sekali.
# Jika mock tidak dipakai, token development HARUS berasal dari workspace terpisah (bukan workspace produksi).
AIRTABLE_MOCK=true

# Airtable — server only, jangan pakai NEXT_PUBLIC_
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Revalidasi manual — server only, jangan pakai NEXT_PUBLIC_
REVALIDATE_SECRET=

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL publik situs
NEXT_PUBLIC_SITE_URL=

# Media sosial — opsional
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
